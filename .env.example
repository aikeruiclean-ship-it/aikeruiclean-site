# =============================================================
# Aikerui Environment Variables
# Copy this file to .env.local and fill in your real values
# =============================================================

# --- Brevo (Sendinblue) API — for inquiry email delivery ---
# Get your key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# --- Google Tag Manager ---
# Create a GTM container at: https://tagmanager.google.com
# Inside GTM, set up:
#   1. GA4 Configuration tag (measurement ID: G-XXXXXXXXXX)
#   2. Google Ads Conversion Tracking tag
#   3. Form submission triggers
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Optional: Stripe ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
